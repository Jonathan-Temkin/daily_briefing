# Copy this file to ".env" (same folder) and fill in your real Renpho account
# credentials. Never share or commit the .env file -- it's plaintext.
# In the cloud version, this file is written at the start of each run from
# the "renpho.env" file stored in the daily-briefing-cloud-data Drive folder
# -- see CLOUD_RUNBOOK.md.
RENPHO_EMAIL=
RENPHO_PASSWORD=

# Copy this file to ".env" (same folder) and fill in the Client ID / Client
# Secret from your Withings developer app (see ../SETUP.md for how to
# register one). WITHINGS_REFRESH_TOKEN is filled in automatically by
# authorize.py the first time you run it -- leave it blank until then.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REFRESH_TOKEN=
